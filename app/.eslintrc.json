{
	"env": {
		"es2021": true
	},
	"extends": ["eslint:recommended", "plugin:react/recommended"],
	"parserOptions": {
		"ecmaVersion": "latest",
		"sourceType": "module"
	},
	"plugins": ["react"],
	"rules": {
		"semi": ["error", "always"]
	},
	"settings": {
		"react": {
			"version": "detect"
		}
	}
}
